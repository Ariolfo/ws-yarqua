{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "AccessMinutes": 60,
    "RefreshDays": 30
  },
  "Visualiti": {
    "Enabled": true,
    "LoginUrl": "http://appgricultor.com/api/login",
    "ApiUrl": "https://api.appgricultor.com",
    "Cliente": "AGROSAVIA",
    "Usuario": "",
    "Password": "",
    "SslVerify": false
  },
  "Cors": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "sinkOptionsSection": {
            "tableName": "YarqtbLog",
            "schemaName": "dbo",
            "autoCreateSqlTable": true,
            "batchPostingLimit": 50,
            "batchPeriod": "00:00:05"
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Yarqua.Api"
    }
  },
  "AllowedHosts": "*"
}
